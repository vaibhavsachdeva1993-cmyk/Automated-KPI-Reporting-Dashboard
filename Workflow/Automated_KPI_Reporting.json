      ],
      "id": "54a824e2-bd2f-4420-88ca-dfb4cdba2383",
      "name": "KPI Summary",
      "credentials": {
        "postgres": {
          "id": "qzPZDTcrxSzkLcNM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \np.category AS Product_Category,\nSUM(f.sales) AS Total_Sales\n  \nFROM public.fact_sales f \nINNER JOIN \npublic.dim_product p\nON \np.product_key = f.product_key\nGROUP BY \np.category\nORDER BY \nSUM(f.sales) DESC",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1216,
        -304
      ],
      "id": "7f706666-88e9-4502-a23f-de5fa59e4ee7",
      "name": "Sales by Category",
      "credentials": {
        "postgres": {
          "id": "qzPZDTcrxSzkLcNM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \nc.region AS Region,\nSUM(f.sales) AS Total_Sales\n  \nFROM public.fact_sales f \nINNER JOIN \npublic.dim_customer c\nON \nc.customer_key = f.customer_key\nGROUP BY \nc.region\nORDER BY \nSUM(f.sales) DESC",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1184,
        -144
      ],
      "id": "29727d46-0363-41ee-86e4-158d87498613",
      "name": "Sales by Region",
      "credentials": {
        "postgres": {
          "id": "qzPZDTcrxSzkLcNM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \nd.month_year AS Date, \nSUM(f.sales) AS Total_Sales\n\nFROM \npublic.fact_sales f \nJOIN \npublic.dim_date d \nON \nf.date_key = d.date_key\nGROUP BY \nd.month_year, \nd.year, \nd.month_number\nORDER BY \nd.year, \nd.month_number",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -960,
        16
      ],
      "id": "6f606827-9c7f-41b9-837d-64726353a140",
      "name": "Monthly Sales Trend",
      "credentials": {
        "postgres": {
          "id": "qzPZDTcrxSzkLcNM",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \np.product_name AS Product_Name,\nSUM(f.sales) AS Total_Sales\n  \nFROM public.fact_sales f \nINNER JOIN \npublic.dim_product p\nON \np.product_key = f.product_key\nGROUP BY \np.product_name\nORDER BY \nSUM(f.sales) DESC\nLIMIT 10;",
        "options": {}
