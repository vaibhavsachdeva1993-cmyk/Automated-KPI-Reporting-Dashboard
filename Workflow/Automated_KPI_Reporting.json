    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \nSUM(sales) AS Total_Sales, \nCOUNT(sales_key) AS Order_Count, \nROUND(SUM(sales)/COUNT(sales_key),2) AS Average_Order_Value\nFROM \npublic.fact_sales;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
